[Unit]
Description=Noctalia Greeter
After=systemd-user-sessions.service
After=getty@tty1.service kmsconvt@tty1.service
Conflicts=getty@tty1.service kmsconvt@tty1.service

[Service]
Type=simple
ExecStart=/usr/bin/greetd --config /usr/share/greetd/noctalia-greeter.toml
IgnoreSIGPIPE=no
SendSIGHUP=yes
TimeoutStopSec=30s
KeyringMode=shared
Restart=always
RestartSec=1
StartLimitBurst=5
StartLimitInterval=30

[Install]
Alias=display-manager.service
