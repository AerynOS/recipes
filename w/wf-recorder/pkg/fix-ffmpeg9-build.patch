@@ -191,6 +191,40 @@ AVPixelFormat FrameWriter::handle_buffersink_pix_fmt(const AVCodec *codec)
 
     auto in_fmt = get_input_format();
 
+    // AVCodec::pix_fmts was deprecated in FFmpeg 7.1 and removed in FFmpeg 9.
+    // avcodec_get_supported_config() returns the same list together with its
+    // entry count, so use it when available.
+#if LIBAVCODEC_VERSION_INT >= AV_VERSION_INT(61, 13, 100)
+    const AVPixelFormat *pix_fmts = NULL;
+    int num_pix_fmts = 0;
+
+    int ret = avcodec_get_supported_config(
+        NULL,
+        codec,
+        AV_CODEC_CONFIG_PIX_FORMAT,
+        0,
+        (const void **)&pix_fmts,
+        &num_pix_fmts);
+
+    /* For codecs such as rawvideo no supported formats are listed */
+    if (ret < 0 || !pix_fmts || num_pix_fmts == 0)
+        return in_fmt;
+
+    /* If the codec supports getting the appropriate RGB format
+     * directly, we want to use it since we don't have to convert data */
+    if (is_fmt_supported(in_fmt, pix_fmts))
+        return in_fmt;
+
+    /* Choose the format supported by the codec which best approximates the
+     * input fmt. */
+    AVPixelFormat best_format = AV_PIX_FMT_NONE;
+    for (int i = 0; i < num_pix_fmts; i++) {
+        int loss = 0;
+        best_format = av_find_best_pix_fmt_of_2(best_format,
+            pix_fmts[i], in_fmt, false, &loss);
+    }
+    return best_format;
+#else
     /* For codecs such as rawvideo no supported formats are listed */
     if (!codec->pix_fmts)
         return in_fmt;
@@ -209,6 +243,7 @@ AVPixelFormat FrameWriter::handle_buffersink_pix_fmt(const AVCodec *codec)
             codec->pix_fmts[i], in_fmt, false, &loss);
     }
     return best_format;
+#endif
 }
 
