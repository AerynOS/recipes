From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Viktar Lukashonak <myxabeer@gmail.com>
Date: Tue, 21 Jul 2026 15:17:55 +0300
Subject: [PATCH] cavaBump

---
 man/waybar-cava.5.scd             | 2 +-
 meson.build                       | 2 +-
 nix/default.nix                   | 6 +++---
 src/modules/cava/cava_backend.cpp | 2 --
 subprojects/libcava.wrap          | 8 ++++----
 5 files changed, 9 insertions(+), 11 deletions(-)

diff --git a/man/waybar-cava.5.scd b/man/waybar-cava.5.scd
index 95336e24..f0efef13 100644
--- a/man/waybar-cava.5.scd
+++ b/man/waybar-cava.5.scd
@@ -641,7 +641,7 @@ vertex_shader = pass_through.vert
 fragment_shader = bar_spectrum.frag
 
 ; for glsl output mode, keep rendering even if no audio
-continuous_rendering = 1;
+continuous_rendering = 1
 
 # disable console blank (screen saver) in tty
 # (Not supported on FreeBSD)
diff --git a/meson.build b/meson.build
index db9407eb..d94fdb0c 100644
--- a/meson.build
+++ b/meson.build
@@ -498,7 +498,7 @@ else
 endif
 
 cava = dependency('libcava',
-                  version : '>=0.10.7',
+                  version : '>=1.0.0',
                   required: get_option('cava'),
                   fallback : ['libcava', 'cava_dep'],
                   not_found_message: 'cava is not found. Building waybar without cava')
diff --git a/nix/default.nix b/nix/default.nix
index 43b6e097..b6e1e893 100644
--- a/nix/default.nix
+++ b/nix/default.nix
@@ -6,13 +6,13 @@
 }:
 let
   libcava = rec {
-    version = "0.10.7-beta";
+    version = "1.0.0";
     src = pkgs.fetchFromGitHub {
       owner = "LukashonakV";
       repo = "cava";
       # NOTE: Needs to match the cava.wrap
-      tag = "v${version}";
-      hash = "sha256-IX1B375gTwVDRjpRfwKGuzTAZOV2pgDWzUd4bW2cTDU=";
+      tag = "${version}";
+      hash = "sha256-0r5aAmTs+FcmS501tNYKxG9H+Pq6i32BDRBEjWW6M74=";
     };
   };
 in
diff --git a/src/modules/cava/cava_backend.cpp b/src/modules/cava/cava_backend.cpp
index c576f0cf..bc46b73c 100644
--- a/src/modules/cava/cava_backend.cpp
+++ b/src/modules/cava/cava_backend.cpp
@@ -200,8 +200,6 @@ void waybar::modules::cava::CavaBackend::loadConfig() {
   prm_.xaxis = ::cava::xaxis_scale::NONE;
   prm_.mono_opt = ::cava::AVERAGE;
   prm_.autobars = 0;
-  if (config_["gravity"].isInt()) prm_.gravity = config_["gravity"].asInt();
-  if (config_["integral"].isInt()) prm_.integral = config_["integral"].asInt();
 
   if (config_["framerate"].isInt()) prm_.framerate = config_["framerate"].asInt();
   // Calculate delay for Update() thread
diff --git a/subprojects/libcava.wrap b/subprojects/libcava.wrap
index 466e2262..821bbd5f 100644
--- a/subprojects/libcava.wrap
+++ b/subprojects/libcava.wrap
@@ -4,9 +4,9 @@
 #depth = 1
 
 [wrap-file]
-directory = cava-0.10.7-beta
-source_url = https://github.com/LukashonakV/cava/archive/v0.10.7-beta.tar.gz
-source_filename = cava-0.10.7.tar.gz
-source_hash = 8915d7214f2046554c158fe6f2ae518881dfb573e421ea848727be11a5dfa8c4
+directory = cava-1.0.0
+source_url = https://github.com/LukashonakV/cava/archive/1.0.0.tar.gz
+source_filename = cava-1.0.0.tar.gz
+source_hash = 437df0a29e52e555357a06238f4c5cbe6d51b5dd4225700cb7adbb19d8bb9474
 [provide]
 libcava = cava_dep
